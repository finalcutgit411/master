# Réglages de shellcheck pour ce projet (lu automatiquement)

# Le script est découpé en fichiers chargés par finalcut.sh : les variables
# d'un fichier sont utilisées dans les autres, ce que shellcheck ne peut pas
# voir quand il analyse chaque fichier séparément.
disable=SC2034,SC2154

# Les fichiers d'état (/etc/finalcut/*.conf) sont chargés dynamiquement.
disable=SC1090,SC1091

external-sources=true
source-path=SCRIPTDIR
